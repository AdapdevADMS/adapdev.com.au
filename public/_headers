# Cloudflare Pages response headers.
# Section 12.1 of the ADMS Website Build Guide ("Security headers").
# Applied at deploy time to every static asset served from this project.

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Long cache for hashed assets emitted by Astro into /_astro/*
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are self-hosted; cache aggressively.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
