---
/**
 * BaseLayout.astro
 *
 * Shared chrome for every page: HTML document shell, head metadata,
 * Open Graph tags, security-related meta, header, footer, skip link.
 *
 * Props:
 *   title       - page-specific <title>; concatenated with the site name
 *   description - meta description (<=160 chars recommended)
 *   image       - absolute URL to the Open Graph preview image
 *   noindex     - when true, emits a robots noindex directive
 *
 * See:
 *   - Section 5 of ADMS Website Build Guide (brand foundation)
 *   - Section 12 of ADMS Website Build Guide (operational hardening)
 */

import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';

import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const SITE_NAME = 'Adapdev';
const DEFAULT_DESCRIPTION =
  'Adapdev Pty Ltd builds bespoke software for Australian sole traders, small businesses and law firms.';
const DEFAULT_OG_IMAGE = '/og/adapdev-og.png';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://adapdev.com.au').toString();
const ogImage = new URL(image, Astro.site ?? 'https://adapdev.com.au').toString();

/*
 * Content Security Policy
 * -----------------------
 * Mirrors the CSP in public/_headers so the policy is present even on
 * surfaces that strip response headers (local file:// previews, printed-to-PDF
 * copies, email-render pre-fetches). The response-header version in _headers
 * remains authoritative for the live site - see Section 12.1 of the build
 * guide for the complete header set.
 */
const CSP = [
  "default-src 'self'",
  "img-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self'",
  "connect-src 'self' https://challenges.cloudflare.com",
  "frame-ancestors 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Icons */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Discoverability */}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Adapdev - Blog"
      href="/blog/rss.xml"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
