---
/**
 * About page - company backstory, ABN, Australian presence.
 * Section 8 step 18 (second bullet) of the ADMS Website Build Guide.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description =
  'Adapdev Pty Ltd is an Australian software developer building on-premises products for sole traders, small businesses and law firms.';
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container prose">
      <h1>About Adapdev</h1>
      <p class="lede">
        Adapdev Pty Ltd designs and builds practical software for Australian small
        business. We are a specialist shop, not a reseller, not a consultancy - the
        people who talk to you are the people writing the code.
      </p>

      <h2>What we build</h2>
      <p>
        Our flagship product is <a href="/adms">ADMS</a>, a digital document
        management system aimed at the three kinds of operator who still manage
        matter files, client folders and job paperwork by hand: sole traders,
        small businesses, and small-to-medium law firms. ADMS runs on your own
        hardware, integrates with Microsoft Office, and keeps your documents in
        a familiar client / matter / job structure that reflects how you already
        work.
      </p>

      <h2>How we work</h2>
      <ul>
        <li>
          <strong>On-premises first.</strong> Your data stays on your hardware.
          No mandatory cloud subscription, no exfiltration of client material to
          a third party.
        </li>
        <li>
          <strong>Clean architecture, modern .NET.</strong> ADMS is built on
          .NET 9 with a WPF desktop client (Prism) and a REST API backend
          targeting SQL Server or SQLite.
        </li>
        <li>
          <strong>Direct line to the developer.</strong> You will not be routed
          through a tier-one support queue. When something breaks, the person
          who shipped it is the person who fixes it.
        </li>
        <li>
          <strong>Australian compliance.</strong> Everything we build is
          designed to meet the obligations of the Privacy Act 1988 and the
          Notifiable Data Breaches scheme.
        </li>
      </ul>

      <h2>Company details</h2>
      <dl class="meta">
        <dt>Company</dt>
        <dd>Adapdev Pty Ltd</dd>
        <dt>Country</dt>
        <dd>Australia</dd>
        <dt>Products</dt>
        <dd>ADMS (Adapdev Document Management System)</dd>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--space-7); }

  .prose {
    max-width: 72ch;
  }

  .lede {
    font-size: var(--fs-lg);
    color: var(--brand-text);
  }

  .meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--brand-tint);
    border-left: 4px solid var(--brand-bright);
    border-radius: var(--radius-md);
  }

  .meta dt {
    font-weight: 600;
    color: var(--brand-navy-deep);
  }

  .meta dd {
    margin: 0;
  }
</style>
