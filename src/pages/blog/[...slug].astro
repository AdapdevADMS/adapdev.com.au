---
/**
 * Dynamic blog post route.
 * Section 8 step 18 (fourth bullet) of the ADMS Website Build Guide.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (d: Date): string =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
>
  <article class="section">
    <div class="container prose">
      <p class="back"><a href="/blog">&larr; All posts</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        By {post.data.author} &middot;
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <span class="muted"> (updated {formatDate(post.data.updatedDate)})</span>
        )}
      </p>

      <div class="post-body">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <p class="tags">
          {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
        </p>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .section { padding-block: var(--space-7); }

  .prose { max-width: 68ch; }

  .back {
    margin: 0 0 var(--space-5);
  }

  .meta {
    color: var(--brand-mute);
    margin-bottom: var(--space-6);
  }

  .post-body :global(h2) {
    margin-top: var(--space-6);
  }

  .post-body :global(h3) {
    margin-top: var(--space-5);
  }

  .post-body :global(blockquote) {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--brand-bright);
    background: var(--brand-tint);
    border-radius: var(--radius-md);
    color: var(--brand-text);
  }

  .post-body :global(pre) {
    margin: var(--space-5) 0;
  }

  .tags {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--brand-rule);
  }

  .tag {
    color: var(--brand-royal);
    font-weight: 500;
  }
</style>
