---
/**
 * Blog index - lists published posts, newest first.
 * Section 8 step 18 (fourth bullet) of the ADMS Website Build Guide.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const formatDate = (d: Date): string =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Release notes, essays and practical pieces from Adapdev."
>
  <section class="section">
    <div class="container prose">
      <h1>Blog</h1>
      <p class="lede">
        Release notes, essays and practical pieces. The RSS feed lives at
        <a href="/blog/rss.xml">/blog/rss.xml</a>.
      </p>

      {posts.length === 0 ? (
        <p class="muted">No posts yet - come back soon.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li class="post">
              <a href={`/blog/${post.slug}`} class="post__link">
                <h2 class="post__title">{post.data.title}</h2>
                <p class="post__meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  {post.data.tags.length > 0 && (
                    <span class="post__tags">
                      {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
                    </span>
                  )}
                </p>
                <p class="post__desc">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--space-7); }

  .prose { max-width: 72ch; }

  .lede {
    font-size: var(--fs-lg);
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    gap: var(--space-4);
  }

  .post {
    border: 1px solid var(--brand-rule);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .post:hover {
    border-color: var(--brand-bright);
    box-shadow: var(--shadow-sm);
  }

  .post__link {
    display: block;
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .post__title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xl);
    color: var(--brand-navy-deep);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin: 0 0 var(--space-2);
    color: var(--brand-mute);
    font-size: var(--fs-sm);
  }

  .post__tags {
    display: inline-flex;
    gap: var(--space-2);
  }

  .tag {
    color: var(--brand-royal);
    font-weight: 500;
  }

  .post__desc {
    margin: 0;
    color: var(--brand-text);
  }
</style>
