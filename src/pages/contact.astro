---
/**
 * Contact page - form posting to /api/contact.
 *
 * The /api/contact endpoint is a Cloudflare Pages Function (see section 9.1
 * of the ADMS Website Build Guide). It validates the Turnstile token,
 * rate-limits by IP, and relays the message via Resend or Postmark.
 *
 * The Turnstile sitekey is PUBLIC and belongs in client-side markup; the
 * secret key is held in the Cloudflare Pages environment and never ships
 * to the browser.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact';
const description = 'Get in touch with Adapdev Pty Ltd about ADMS or bespoke software work.';

// Replace with the real sitekey from the Cloudflare dashboard. Safe to commit.
const TURNSTILE_SITEKEY = '1x00000000000000000000AA';
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container prose">
      <h1>Get in touch</h1>
      <p class="lede">
        Tell us what you're trying to do. We reply within one business day,
        Monday to Friday, Australian Eastern time.
      </p>

      <form method="post" action="/api/contact" class="contact-form" novalidate>
        <label>
          <span>Your name</span>
          <input type="text" name="name" required autocomplete="name" minlength="2" maxlength="120" />
        </label>

        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" maxlength="240" />
        </label>

        <label>
          <span>Business type</span>
          <select name="businessType" required>
            <option value="">Please select...</option>
            <option value="sole-trader">Sole trader</option>
            <option value="small-business">Small business</option>
            <option value="law-firm">Law firm</option>
            <option value="other">Other</option>
          </select>
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" required rows="6" minlength="10" maxlength="4000"></textarea>
        </label>

        {/* Honeypot - hidden from humans, bots fill it. The server rejects any submission with a non-empty value. */}
        <label class="hp" aria-hidden="true">
          <span>Leave this field blank</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <div
          class="cf-turnstile"
          data-sitekey={TURNSTILE_SITEKEY}
          data-theme="light"
        />

        <div class="actions">
          <button type="submit" class="btn">Send message</button>
          <p class="muted">
            We don't track you, store cookies, or share your details. See our
            <a href="/privacy">privacy policy</a>.
          </p>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

{/* Turnstile client. Loaded with defer so it never blocks the first paint. */}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>

<style>
  .section { padding-block: var(--space-7); }

  .prose { max-width: 60ch; }

  .lede {
    font-size: var(--fs-lg);
    color: var(--brand-text);
  }

  .contact-form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .contact-form label {
    display: grid;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--brand-navy);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    padding: var(--space-3);
    border: 1px solid var(--brand-rule);
    border-radius: var(--radius-sm);
    background: var(--brand-white);
    color: var(--brand-text);
    font: inherit;
    transition: border-color var(--duration-fast) var(--ease-standard),
                box-shadow var(--duration-fast) var(--ease-standard);
  }

  .contact-form input:focus-visible,
  .contact-form select:focus-visible,
  .contact-form textarea:focus-visible {
    border-color: var(--brand-bright);
    box-shadow: 0 0 0 3px rgba(46, 141, 216, 0.25);
    outline: none;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
</style>
