---
/**
 * Footer.astro - Site-wide footer with copyright and secondary links.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="muted">
      &copy; {year} Adapdev Pty Ltd. All rights reserved. ABN registered in Australia.
    </p>
    <nav aria-label="Footer">
      <ul class="footer-nav">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/blog/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-5);
    border-top: 1px solid var(--brand-rule);
    background: var(--brand-tint-2);
    color: var(--brand-mute);
    font-size: var(--fs-sm);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    color: var(--brand-navy);
  }
</style>
