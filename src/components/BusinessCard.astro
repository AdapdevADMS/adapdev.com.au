---
/**
 * BusinessCard.astro
 * Hero/landing card for one of the three ADMS target business types.
 * Used on the home page and reused on /adms if desired.
 */

export interface Props {
  title: string;
  blurb: string;
  href: string;
  icon?: 'tools' | 'briefcase' | 'scales';
}

const { title, blurb, href, icon = 'briefcase' } = Astro.props;

const paths: Record<NonNullable<Props['icon']>, string> = {
  // Simple glyphs - stroked, no fill, inherit currentColor.
  tools:
    'M14 7 20 1 23 4 17 10 M14 7 L5 16 A2 2 0 0 0 5 19 L5 19 A2 2 0 0 0 8 19 L17 10',
  briefcase:
    'M3 8 H21 V20 H3 Z M9 8 V5 A2 2 0 0 1 11 3 H13 A2 2 0 0 1 15 5 V8',
  scales:
    'M12 3 V21 M3 21 H21 M6 8 L3 15 A3 3 0 0 0 9 15 Z M18 8 L15 15 A3 3 0 0 0 21 15 Z M3 8 H21',
};
---

<a href={href} class="card">
  <span class="card__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d={paths[icon]} />
    </svg>
  </span>
  <h3 class="card__title">{title}</h3>
  <p class="card__blurb">{blurb}</p>
  <span class="card__cta">Learn more <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--brand-white);
    border: 1px solid var(--brand-rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-med) var(--ease-standard),
      box-shadow var(--duration-med) var(--ease-standard),
      border-color var(--duration-med) var(--ease-standard);
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--brand-bright);
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--brand-tint);
    color: var(--brand-navy-deep);
  }

  .card__title {
    margin: 0;
    font-size: var(--fs-lg);
    color: var(--brand-navy-deep);
  }

  .card__blurb {
    margin: 0;
    color: var(--brand-text);
  }

  .card__cta {
    margin-top: auto;
    font-weight: 600;
    color: var(--brand-royal);
  }

  .card:hover .card__cta,
  .card:focus-visible .card__cta {
    color: var(--brand-bright);
  }
</style>
